# ===== Môi trường =====
# dev: bật /dev/token (sinh JWT giả lập) và trang test. PROD phải đặt ENV=prod.
ENV=dev

# ===== JWT (HS256) của OMS =====
# DEV: secret tự đặt. PROD: dùng đúng secret của OMS, cấp qua Docker secret.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_AUDIENCE=
JWT_ISSUER=
# Role được phép quản trị tài liệu thay cho permission (để trống = chỉ dùng permission)
KB_ADMIN_PERMISSION=Assistant.KB.Manage
KB_ADMIN_ROLES=

# ===== Model (Ollama) =====
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=bge-m3
# Model đọc ảnh (PNG/JPG và hình trong Word). Để trống = tắt.
VISION_MODEL=qwen2.5vl:3b
NUM_THREAD=0
NUM_CTX=6144
NUM_PREDICT=400
TEMPERATURE=0.1

# ===== RAG =====
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=oms_kb
TOP_K_SEARCH=12
TOP_K_FINAL=4
MAX_CONTEXT_CHARS=6000
# Ngưỡng cosine tối thiểu để được trả lời (thấp hơn => từ chối, không gọi LLM). Chỉnh theo log top_score.
MIN_SCORE=0.45
SCREEN_BOOST=0.05
# Kiểm tra câu trả lời có bám tài liệu không (thay cho trích dẫn)
GROUNDEDNESS_ENABLED=true
GROUND_MIN_SIM=0.45
GROUND_MAX_UNGROUNDED=0.5
REWRITE_ENABLED=true
MAX_CONCURRENT_CHAT=2
RATE_LIMIT_PER_MIN=20

# ===== PostgreSQL (container riêng của dự án này) =====
POSTGRES_PASSWORD=assistant_dev_pw
DATABASE_URL=postgresql://assistant:assistant_dev_pw@postgres:5432/assistant
MAX_IMAGES_PER_DOC=30

# ===== Khác =====
DATA_DIR=/data
SCREENS_FILE=/config/screens.yaml
CORS_ORIGINS=*
MAX_UPLOAD_MB=25
